        "toUid": { "type": "string", "maxLength": 128 },
        "toName": { "type": "string", "maxLength": 80 },
        "toAvatarId": { "type": "string", "maxLength": 40 },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined", "cancelled"],
          "maxLength": 20
        },
        "createdAtIso": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "fromUid", "fromName", "toUid", "toName", "status", "createdAtIso"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public user profile cards (no PII)."
    },
    "/users/{userId}/private/{docId}": {
