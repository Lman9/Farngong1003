{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public profile information for a registered workplace almanac user, excluding PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Public display name chosen by the user."
        },
        "jobTitle": {
          "type": "string",
          "maxLength": 80,
          "description": "User's self-reported workplace title or persona."
        },
        "district": {
          "type": "string",
          "maxLength": 60,
          "description": "Hong Kong working district."
        },
        "bio": {
          "type": "string",
          "maxLength": 600,
          "description": "Personal self-introduction and workplace motto."
        },
        "avatarId": {
          "type": "string",
          "maxLength": 40,
          "description": "Selected retro avatar icon ID."
        },
        "activeFrame": {
          "type": "string",
          "maxLength": 40,
          "description": "Equipped profile frame decoration ID."
        },
        "activeBadge": {
          "type": "string",
          "maxLength": 40,
          "description": "Equipped title stamp badge ID."
        },
        "activeCharm": {
          "type": "string",
          "maxLength": 40,
          "description": "Equipped profile corner charm ID."
        },
        "points": {
          "type": "number",
          "description": "Current redeemable mission points balance."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "uid",
        "displayName",
        "jobTitle",
        "district",
        "bio",
        "avatarId",
        "activeFrame",
        "activeBadge",
        "activeCharm",
        "points",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateData": {
      "title": "UserPrivateData",
      "description": "Isolated private user data including email, enclosed CV, unlocked shop items, and completed missions.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "maxLength": 200,
          "description": "Private email address."
        },
        "authProvider": {
          "type": "string",
          "maxLength": 40,
          "description": "Authentication provider used (google, email, apple, facebook)."
        },
        "cvFileName": {
          "type": "string",
          "maxLength": 160,
          "description": "Enclosed CV file name."
        },
        "cvSummary": {
          "type": "string",
          "maxLength": 1500,
          "description": "Enclosed CV executive summary and experience."
        },
        "cvSkills": {
          "type": "string",
          "maxLength": 500,
          "description": "Comma-separated key workplace skills."
        },
        "cvExperience": {
          "type": "string",
          "maxLength": 200,
          "description": "Years of experience and seniority."
        },
        "cvPortfolioUrl": {
          "type": "string",
          "maxLength": 300,
          "description": "Portfolio or LinkedIn link."
        },
        "cvContentData": {
          "type": "string",
          "maxLength": 150000,
          "description": "Encoded CV attachment content or text."
        },
        "unlockedItemsCsv": {
          "type": "string",
          "maxLength": 2000,
          "description": "Comma-separated IDs of unlocked shop decorations and touch icons."
        },
        "completedMissionsCsv": {
          "type": "string",
          "maxLength": 2000,
          "description": "Comma-separated IDs of claimed missions."
        },
        "lastLoginDate": {
          "type": "string",
          "maxLength": 20,
          "description": "YYYY-MM-DD date string of last daily login reward."
        },
        "adWatchCount": {
          "type": "number",
          "description": "Total number of retro ads watched."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "uid",
        "email",
        "authProvider",
        "cvFileName",
        "cvSummary",
        "cvSkills",
        "cvExperience",
        "cvPortfolioUrl",
        "cvContentData",
        "unlockedItemsCsv",
        "completedMissionsCsv",
        "lastLoginDate",
        "adWatchCount",
        "updatedAt"
      ]
    },
    "UserSubmittedEvent": {
      "title": "UserSubmittedEvent",
      "description": "User-created after-work event requiring admin approval before publishing.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Event document ID."
        },
        "creatorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the user who created the event."
        },
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Name of the host or organization."
        },
        "hostRole": {
          "type": "string",
          "maxLength": 80,
          "description": "Host role description."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Event title."
        },
        "date": {
          "type": "string",
          "maxLength": 60,
          "description": "Event date."
        },
        "time": {
          "type": "string",
          "maxLength": 60,
          "description": "Event time."
        },
        "location": {
          "type": "string",
          "maxLength": 120,
          "description": "Event venue address."
        },
        "district": {
          "type": "string",
          "maxLength": 60,
          "description": "Hong Kong district."
        },
        "fee": {
          "type": "string",
          "maxLength": 60,
          "description": "Admission fee string."
        },
        "totalSpots": {
          "type": "number",
          "description": "Total participant capacity."
        },
        "spotsLeft": {
          "type": "number",
          "description": "Remaining available spots."
        },
        "category": {
          "type": "string",
          "enum": ["wellness", "sports", "creative", "social"],
          "maxLength": 30,
          "description": "Event category."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Event description."
        },
        "perksCsv": {
          "type": "string",
          "maxLength": 500,
          "description": "Pipe-separated perks included."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "maxLength": 20,
          "description": "Moderation status controlled by admin."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "id",
        "creatorUid",
        "hostName",
        "hostRole",
        "title",
        "date",
        "time",
        "location",
        "district",
        "fee",
        "totalSpots",
        "spotsLeft",
        "category",
        "description",
        "perksCsv",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
