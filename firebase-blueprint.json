      "schema": { "$ref": "#/entities/UserSavedRestaurant" },
      "description": "Owner-only saved favourite restaurants from real-time map scraping."
    },
    "/user_events/{eventId}": {
      "schema": { "$ref": "#/entities/UserSubmittedEvent" },
      "description": "User-submitted events with pending/approved/rejected moderation status."
    },
    "/event_registrations/{regId}": {
      "schema": { "$ref": "#/entities/EventRegistration" },
      "description": "User event registrations."
    },
    "/job_applications/{appId}": {
      "schema": { "$ref": "#/entities/JobApplication" },
      "description": "User job applications with enclosed CV."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRole" },
      "description": "Administrator lookup collection."
    },
    "/minigame_scores/{scoreId}": {
      "schema": { "$ref": "#/entities/MiniGameScore" },
      "description": "Public high score submissions and rankings for pet arcade mini-games."
    },
    "/villain_leaderboard/{uid}": {
      "schema": { "$ref": "#/entities/VillainLeaderboardEntry" },
      "description": "Global Villain Hitting leaderboard entries across all users."
    },
    "/community_tips/{tipId}": {
      "schema": { "$ref": "#/entities/CommunityTip" },
      "description": "Community-submitted workplace trivia tips with upvote stamps."
    },
    "/community_restaurants/{restId}": {
      "schema": { "$ref": "#/entities/CommunityRestaurant" },
      "description": "Community-submitted lunch restaurant recommendations with upvote stamps."
    },
    "/user_presence/{uid}": {
      "schema": { "$ref": "#/entities/UserPresence" },
      "description": "Real-time online and last-online presence records for friends."
    },
    "/community_posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityGeneralPost" },
      "description": "Community-submitted workplace secrets, neighborhood recommendations, and after-work chat posts."
    },
    "/live_chat_messages/{msgId}": {
      "schema": { "$ref": "#/entities/LiveChatMessage" },
